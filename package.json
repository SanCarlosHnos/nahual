{
  "name": "nahual",
  "version": "0.5.0",
  "description": "Nahual: IA local con ventana gráfica y avatar 3D que construye software y se mejora a sí misma",
  "type": "module",
  "private": true,
  "main": "electron/main.mjs",
  "bin": {
    "nahual": "supervisor.mjs"
  },
  "scripts": {
    "start": "node supervisor.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "autopruebas": "tsx src/autopruebas.ts",
    "verificar": "node nucleo/verificar.mjs ."
  },
  "dependencies": {
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "electron": "^45.2.3",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
