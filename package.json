{
  "name": "nahual",
  "version": "0.5.0",
  "description": "Nahual: IA local con ventana gráfica y avatar 3D que construye software y se mejora a sí misma",
  "type": "module",
  "private": true,
  "main": "electron/main.mjs",
  "bin": {
    "nahual": "supervisor.mjs"
  },
  "scripts": {
    "start": "node supervisor.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "autopruebas": "tsx src/autopruebas.ts",
    "verificar": "node nucleo/verificar.mjs .",
    "build": "electron-builder --win --x64",
    "build:portable": "electron-builder --win portable"
  },
  "dependencies": {
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@babel/eslint-parser": "^8.0.7",
    "@babel/preset-typescript": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "build": {
    "appId": "com.nahual.app",
    "productName": "Nahual",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "nucleo/**/*",
      "supervisor.mjs",
      "package.json",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "Nahual-Portable-${version}.exe"
    },
    "publish": {
      "provider": "github",
      "releaseType": "release"
    }
  }
}
